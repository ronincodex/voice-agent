# ===== AI services =====
SARVAM_API_KEY=your_sarvam_api_key_here
GROQ_API_KEY=your_groq_api_key_here
SARVAM_STT_MODE=codemix

# ===== Daily (WebRTC for local testing) =====
DAILY_API_KEY=your_daily_api_key_here

# ===== Application Config =====
DEFAULT_LANGUAGE=hi-IN

# ===== Telephony: Vobiz =====
#TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#TWILIO_AUTH_TOKEN=your_auth_token_here
#TWILIO_PHONE_NUMBER=+1415XXXXXXX
#TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#TWILIO_API_SECRET=your_api_secret_here
VOBIZ_AUTH_ID=MA_XXXXXXXX
VOBIZ_AUTH_TOKEN=your-vobiz-auth-token
VOBIZ_PHONE_NUMBER=+918065480214

# ====== Database (Supabase) ======
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# ====== Redis (Upstash) ======
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# ====== Storage (Cloudflare R2) ======
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=voice-recordings

# ====== Fallback Configuration ======
ENABLE_FALLBACK_SUMMARIZER=true
GROQ_LLM_MODEL=openai/gpt-oss-120b

# ====== TRAI Calling-Hour Enforcement ======
# Set to true ONLY for local testing. Must be false in production.
BYPASS_CALLING_HOUR=false

